# Copia a .env y ajusta. NUNCA commitees el .env real.
ENVIRONMENT=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=km0lab
DB_PASSWORD=km0lab
DB_NAME=km0lab

# JWT — genera un secreto largo aleatorio en producción
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=129600

# Entrar con redes sociales. Una red se ofrece cuando está en la lista y
# tiene su identificador de cliente (público). Vacío = solo correo.
AUTH_PROVIDERS=
GOOGLE_CLIENT_ID=

# OTP
OTP_TTL_MINUTES=10
OTP_LENGTH=6
WELCOME_POINTS=100
INVITE_PERSON_POINTS=100
INVITE_BUSINESS_POINTS=500

# Versión mínima de la app admitida (ej. 1.1.0). Vacía = todas. Una app por
# debajo recibe 426 y enseña «actualiza la app». Ver km0lab/docs/VERSIONES.md
MIN_APP_VERSION=

# Territorio QA (pruebas automáticas, CP 99999 y cuentas qa+…@km0lab.com).
# Clave de POST /api/v1/qa/prepare. Vacía = puerta cerrada. Solo actúa con
# ENVIRONMENT=development|staging; en production se ignora.
QA_TOKEN=

# Email — preferir Resend HTTP (Railway no suele poder salir por SMTP:587)
RESEND_API_KEY=
# Fallback SMTP (opcional; en Railway a menudo hace timeout)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente del dominio verificado en Resend (ej. email.km0lab.com)
SMTP_FROM=KM0 LAB <no-reply@email.km0lab.com>

# Dirección que lleva dentro el QR de cada comercio (la abre la cámara del
# móvil). Tiene que ser la de la app de ese entorno y existir de verdad: en
# UAT, https://app.uat.km0lab.com/scan. Si cambia, los QR ya generados se
# redibujan solos, pero los que estén impresos dejan de valer.
QR_SCAN_BASE_URL=https://app.km0lab.com/scan

# Dirección del panel de comercios (backoffice) de este entorno. Va en el
# botón del correo que recibe un comercio al darlo de alta. En UAT,
# https://backoffice.uat.km0lab.com. Vacía = ese correo no se envía.
BACKOFFICE_URL=

# CORS: orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*km0lab\.com|http://localhost:\d+|http://127\.0\.0\.1:\d+

# OpenAI — autotraducción i18n al guardar (API). Sin key = copia el texto fuente.
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# Solo máquina local: URL pública MySQL Railway para «publica todo» / sync_to_railway.
# NO usar en el servicio Railway (ahí van DB_*). Nunca commitear el valor real.
# RAILWAY_DB_URL=mysql://USER:PASS@HOST:PORT/DB
