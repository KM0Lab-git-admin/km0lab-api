# Copia a .env y ajusta. NUNCA commitees el .env real.
ENVIRONMENT=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=km0lab
DB_PASSWORD=km0lab
DB_NAME=km0lab

# JWT — genera un secreto largo aleatorio en producción
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# OTP
OTP_TTL_MINUTES=10
OTP_LENGTH=6
WELCOME_POINTS=100

# Email — preferir Resend HTTP (Railway no suele poder salir por SMTP:587)
RESEND_API_KEY=
# Fallback SMTP (opcional; en Railway a menudo hace timeout)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente del dominio verificado en Resend (ej. email.km0lab.com)
SMTP_FROM=KM0 LAB <no-reply@email.km0lab.com>

# CORS: orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAI — autotraducción i18n al guardar (API). Sin key = copia el texto fuente.
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# Solo máquina local: URL pública MySQL Railway para «publica todo» / sync_to_railway.
# NO usar en el servicio Railway (ahí van DB_*). Nunca commitear el valor real.
# RAILWAY_DB_URL=mysql://USER:PASS@HOST:PORT/DB
