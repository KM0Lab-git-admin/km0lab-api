# Copia a .env y ajusta. NUNCA commitees el .env real.
ENVIRONMENT=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=km0lab
DB_PASSWORD=km0lab
DB_NAME=km0lab

# JWT — genera un secreto largo aleatorio en producción
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# OTP
OTP_TTL_MINUTES=10
OTP_LENGTH=6
WELCOME_POINTS=100

# Email SMTP (vacío en dev = el código OTP se imprime en el log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KM0 LAB <no-reply@km0lab.com>

# CORS: orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
